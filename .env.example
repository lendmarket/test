# Resend(https://resend.com) API 키 — 알림 메일 발송용
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# 상담/서류 접수 알림을 받을 이메일 (쉼표로 여러 명 가능)
NOTIFY_EMAIL=you@example.com

# 보내는 사람 주소 (Resend에서 도메인 인증 후 사용, 미설정 시 onboarding@resend.dev)
FROM_EMAIL=BizRental <noreply@yourdomain.com>

# Vercel Blob 토큰 — Vercel에서 Blob 저장소를 프로젝트에 연결하면 자동으로 추가됨
BLOB_READ_WRITE_TOKEN=
