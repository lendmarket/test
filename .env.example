# Resend(https://resend.com) API 키 — 알림 메일 발송용
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# 상담/서류 접수 알림을 받을 이메일 (쉼표로 여러 명 가능)
NOTIFY_EMAIL=you@example.com

# 보내는 사람 주소 (Resend에서 도메인 인증 후 사용, 미설정 시 onboarding@resend.dev)
FROM_EMAIL=BizRental <noreply@yourdomain.com>

# (선택) 관리자 비밀번호 변경 알림을 받을 이메일 (미설정 시 NOTIFY_EMAIL의 첫 번째 주소)
ADMIN_EMAIL=admin@example.com

# (선택) 관리자 정보 암호화·세션 서명용 비밀키. 미설정 시 BLOB_READ_WRITE_TOKEN에서 파생
# 설정하려면 긴 무작위 문자열 사용. 나중에 바꾸면 저장된 관리자 정보를 못 읽으므로 Blob의 admin/ 파일을 삭제해 초기화해야 함
ADMIN_SECRET=

# Vercel Blob 토큰 — Vercel에서 Blob 저장소를 프로젝트에 연결하면 자동으로 추가됨
BLOB_READ_WRITE_TOKEN=
